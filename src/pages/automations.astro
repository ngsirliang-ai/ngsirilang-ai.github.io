---
// Pillar 3: automations that actually run.
// First resident: the SG Haze Monitor — a Telegram digest of Singapore's
// official PSI/PM2.5 readings, with the TelegramMock component showing
// what the message actually looks like.
import BaseLayout from '../layouts/BaseLayout.astro';
import TelegramMock from '../components/TelegramMock.astro';
---

<BaseLayout title="Automations">
  <section class="hero">
    <h1>Automations</h1>
    <p class="lede">
      Things that run without me — monitors, simulators, and for-fun labs.
      Built once, then left alone to do their job.
    </p>
  </section>

  <article class="automation">
    <h2>SG Haze Monitor</h2>

    <!-- The box: a preview of the actual Telegram message -->
    <div class="preview">
      <TelegramMock botName="Jarv" time="08:00">
        <pre class="report">SG Haze Report — Tue 21 Oct

24-h PSI   trend
North     87   ▲
South     84   ▼
East      91   —
West      95   ▲
Central   88   —

PM2.5 (24h): 17–23 µg/m³
Overall: NORMAL
Source: NEA · data.gov.sg</pre>
      </TelegramMock>
      <p class="preview-note">Preview · sample readings</p>
    </div>

    <!-- The brief description below the box -->
    <p>
      Hourly — a scheduled agent pulls Singapore's official air-quality
      readings from the NEA open API, breaks PSI and PM2.5 down by region,
      and delivers the digest to my family on Telegram.
    </p>

    <p>
      Built on
      <a href="https://hermes-agent.nousresearch.com" rel="noopener">Hermes Agent</a>:
      the hourly schedule is a cron job, the data call is plain HTTP, and the
      agent's brain is whatever model you point it at — here GLM-4.5, which is
      more than enough for a job this small.
    </p>

    <p class="flow-label">Prerequisites</p>
    <ul class="prereq">
      <li>A free <a href="https://data.gov.sg" rel="noopener">data.gov.sg</a> API key — the NEA PSI endpoint requires it</li>
      <li>A Telegram bot from <a href="https://t.me/BotFather" rel="noopener">@BotFather</a>, plus your chat ID</li>
      <li>Any always-on machine (or cron box) that can reach both APIs</li>
    </ul>

    <p class="flow-label">How it runs</p>
    <code class="flow">hourly cron → NEA PSI API (authenticated) → regional PSI / PM2.5 breakdown → formatted digest → Telegram Bot API push</code>
  </article>

  <article class="automation">
    <h2>Lottery Systems Lab</h2>

    <!-- The box: a real scoring run, terminal-style -->
    <div class="preview">
      <div class="term">
        <div class="term-bar"><span></span><span></span><span></span></div>
        <pre class="report">lottery-lab $ score --game mark-six

draws loaded   132 · 2025-10 → 2026-09
latest draw    #104 · 04 28 31 44 47 48  +19

hot numbers    28 ×29   07 ×24   02 ×22
               04 ×22   37 ×22   17 ×20

line A    02 04 28 31 34 47   (+08)
line B    06 07 09 18 19 46   (+34)

→ for the fun of it — draws are random</pre>
      </div>
      <p class="preview-note">Real output · 132 official draws, frequencies computed live</p>
    </div>

    <p>
      Lottery systems as a systems problem. Hong Kong's Mark Six and China's
      SSQ, treated the way I treat hotel markets: pull the official draw
      history, clean it, score every number on frequency and recency with a
      judgment API, and propose candidate lines with the evidence attached.
      Strictly for fun — draws are random, and hit-rate tracking hasn't been
      built (yet).
    </p>

    <p class="flow-label">How it runs</p>
    <code class="flow">HKJC / SSQ draw history → data cleaning → JEV-scored frequency × recency → evidence-backed candidate lines</code>
  </article>
</BaseLayout>

<style>
  .automation { margin-top: 1.5rem; }
  .automation h2 { margin-bottom: 1.25rem; }
  .preview {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 0 1.75rem;
  }
  .preview-note { color: var(--muted); font-size: 0.78rem; margin: 0.55rem 0 0; font-style: italic; }
  .report {
    margin: 0;
    font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
    font-size: 0.78rem;
    line-height: 1.55;
    white-space: pre;
    color: #e8edf2;
  }
  .flow-label { font-weight: 600; margin-bottom: 0.4rem; }
  .flow-label:not(:first-of-type) { margin-top: 1rem; }
  .prereq { margin: 0 0 0.4rem; padding-left: 1.2rem; font-size: 0.925rem; color: var(--text); }
  .prereq li { margin-bottom: 0.25rem; }
  .prereq a { color: var(--accent); }
  /* Terminal-style preview box (Lottery Systems Lab) */
  .term {
    width: 100%;
    max-width: 30rem;
    border: 1px solid var(--border);
    border-radius: 0.7rem;
    overflow: hidden;
    background: #0b0d10;
  }
  .term-bar { display: flex; gap: 0.3rem; padding: 0.45rem 0.6rem; border-bottom: 1px solid var(--border); }
  .term-bar span { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--border); }
  .term .report { padding: 0.8rem 0.95rem; overflow-x: auto; }
  .flow {
    display: block;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.7rem 0.9rem;
    font-size: 0.82rem;
    color: var(--muted);
    overflow-x: auto;
  }
</style>
