</BaseLayout>

<style>
  /* City stops — collapsed headers that expand on hover (desktop) or tap.
     The .stop-body uses the grid 0fr→1fr trick: CSS can't animate
     height:auto, but it CAN animate a grid row from 0 to 1 fraction. */
  .cities { display: flex; flex-direction: column; gap: 0.3rem; margin: 1.5rem 0; }
  .stop {
    border-left: 2px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 0 0 0 1.1rem;
    position: relative;
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .stop:last-child { border-bottom: none; }
  .stop::before {
    content: "";
    position: absolute;
    left: -5px;
    top: 1.05rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border);
    transition: background 0.3s ease;
  }
  .stop.open::before { background: var(--accent); }
  .stop-head {
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    width: 100%;
    padding: 0.45rem 0.25rem;
    cursor: pointer;
    font: inherit;
    color: inherit;
    font-size: 1.02rem;
    transition: font-size 0.3s ease;
  }
  /* Hover/open = 1.5x the resting size (desktop pointers only — on touch,
     tap already opens the stop and a 1.5x jump would feel jumpy) */
  @media (hover: hover) {
    .stop:hover .stop-head,
    .stop.open .stop-head,
    .stop.pinned .stop-head { font-size: 1.53rem; }
  }
  .stop-head:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 0.35rem; }
  .stop-name { font-weight: 600; } /* size inherits from .stop-head so it scales */
  /* Departure-board metadata: mono, uppercase, brass, tabular — the board voice */
  .stop-head .period {
    margin-left: auto;
    white-space: nowrap;
    font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
    font-size: 0.72em; /* em, not rem — scales with the header */
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .chev {
    font-size: 0.78em;
    color: var(--muted);
    transition: transform 0.35s ease;
  }
  .stop.open .chev { transform: rotate(180deg); }
  .stop:hover .chev, .stop.open .chev { color: var(--accent); }
  .stop-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s ease;
  }
  .stop.open .stop-body { grid-template-rows: 1fr; }
  .stop-inner { overflow: hidden; min-height: 0; }
  .stop-inner .roles { margin-top: 0.15rem; }
  @media (prefers-reduced-motion: reduce) {
    .stop-body, .chev, .stop::before, .stop-head, .medal { transition: none; }
  }
  .roles { list-style: none; margin: 0.6rem 0 0.4rem; padding: 0; }
  .roles li { font-size: 0.925rem; color: var(--text); margin-bottom: 0.2rem; }
  .city-note { margin: 0.25rem 0 0; color: var(--muted); font-style: italic; font-size: 0.925rem; }

  /* The wanderer strip */
  .wherenow { list-style: none; display: flex; flex-wrap: wrap; gap: 0.75rem; padding: 0; margin: 1rem 0 0.75rem; }
  .wherenow li {
    border: 1px solid var(--border);
    background: var(--card);
    border-radius: 0.6rem;
    padding: 0.5rem 0.9rem;
    font-size: 0.9rem;
  }
  .chip-label { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-right: 0.45rem; }

  /* Flags & audit stamps — real SVG images (Windows can't show flag emoji) */
  .flags { display: inline-flex; gap: 0.25rem; align-items: center; }
  /* Location medallions — photos cropped into circles, stacked like coins */
  .medals { display: inline-flex; align-items: center; align-self: center; }
  .medal {
    width: 2.55em;  /* em of the header font-size — medallions scale to 1.5x on hover */
    height: 2.55em;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--card);
    box-shadow: 0 0 0 1px var(--border);
    transition: width 0.3s ease, height 0.3s ease;
  }
  .medal + .medal { margin-left: -0.6rem; }
  .flag {
    height: 0.95em;
    width: auto;
    border-radius: 2px;
    outline: 1px solid var(--border);
    vertical-align: -0.1em;
  }
  .stamps { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0.55rem 0 0.25rem; padding: 0; }
  .stamp {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px dashed var(--border);
    border-radius: 999px;
    padding: 0.18rem 0.65rem;
    font-size: 0.8rem;
    color: var(--muted);
    background: var(--card);
  }
  .wherenow li { display: flex; align-items: center; gap: 0.45rem; }

  /* AI stack — label column + tool chips */
  .aistack { list-style: none; margin: 1rem 0; padding: 0; display: flex; flex-direction: column; gap: 0.65rem; }
  .aistack li { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .aistack .chip-label { min-width: 9.5rem; }
  .stack-items { display: inline-flex; flex-wrap: wrap; gap: 0.45rem; }
  .stack-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--border);
    background: var(--card);
    border-radius: 999px;
    padding: 0.24rem 0.75rem;
    font-size: 0.85rem;
  }
  .stack-logo {
    width: 1.15rem;
    height: 1.15rem;
    padding: 2px; /* inset the mark */
    border-radius: 0.3rem;
    object-fit: contain;
    background: #f2efe9; /* light chip so dark logos survive the dark theme */
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.06);
  }

  /* Scroll-reveal removed — stops now expand on hover/tap. */
</style>

<script is:inline>
  // Departure-board behavior:
  //  - On devices with a real mouse (hover: hover): passing over a stop
  //    opens it; moving away closes it again — unless you CLICK, which
  //    pins it open. Click again to unpin.
  //  - On touch: tap toggles. (No hover on phones, so clicks do all the work.)
  const canHover = window.matchMedia('(hover: hover)').matches;
  document.querySelectorAll('.stop-head').forEach((head) => {
    const stop = head.closest('.stop');
    const setOpen = (v) => {
      stop.classList.toggle('open', v);
      head.setAttribute('aria-expanded', String(v));
    };
    head.addEventListener('click', () => {
      const opening = !stop.classList.contains('open');
      setOpen(opening);
      stop.classList.toggle('pinned', opening && canHover);
    });
    if (canHover) {
      // Listen on the WHOLE stop (head + expanded body), so moving the
      // mouse from the header into the details keeps it open — it only
      // closes when the cursor leaves the entire stop.
      stop.addEventListener('mouseenter', () => setOpen(true));
      stop.addEventListener('mouseleave', () =>
        setOpen(stop.classList.contains('pinned')));
    }
  });
</script>
