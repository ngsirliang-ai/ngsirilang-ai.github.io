    flags: ['🇱🇦'],
    city: 'Laos — Luang Prabang & Vientiane',
    period: 'the beginning',
    roles: ['Hotel Sales'],
    note: 'Fresh out of NUS with an economics degree and a suitcase. Sold rooms, learned Lao, learned which promises a hotel actually keeps.',
  },
  {
    flags: ['🇨🇭'],
    city: 'Switzerland',
    period: 'hotel school',
    roles: [],
    note: 'Traded selling rooms for studying them properly.',
  },
  {
    flags: ['🇲🇻', '🇲🇾', '🇹🇭'],
    city: 'Maldives · Kuala Lumpur · Bangkok',
    period: '2014 — 2016',
    roles: [
      'Management Trainee · Minor International — Anantara Maldives → AVANI KL → Bangkok office',
      'Finance Manager · AVANI Hotels & Resorts, Kuala Lumpur',
    ],
    note: 'A management trainee is a suitcase with a job title. Ended up running monthly P&Ls and credit control in KL.',
  },
  {
    flags: ['🇭🇰'],
    stamps: ['🇻🇳 Vietnam', '🇮🇩 Indonesia', '🇹🇭 Thailand', '🇦🇪 Dubai', '🇰🇷 Korea', '🇦🇺 Australia', '🇨🇳 China'],
