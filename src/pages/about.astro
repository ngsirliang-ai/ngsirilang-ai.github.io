---
// About = bio + career timeline + contact.
// Career data below is from your LinkedIn — edit freely, it's yours.
// TODO(design-pass): this page gets real typography treatment later.

import BaseLayout from '../layouts/BaseLayout.astro';

const cities = [
  {
    flags: ['🇱🇦'],
    city: 'Laos — Luang Prabang & Vientiane',
    period: 'the beginning',
    roles: ['Hotel Sales'],
    note: 'Fresh out of NUS with an economics degree and a suitcase. Sold rooms, learned Lao, learned which promises a hotel actually keeps.',
  },
  {
    flags: ['🇨🇭'],
    city: 'Switzerland',
    period: 'hotel school',
    roles: [],
    note: 'Traded selling rooms for studying them properly.',
  },
  {
    flags: ['🇲🇻', '🇲🇾', '🇹🇭'],
    city: 'Maldives · Kuala Lumpur · Bangkok',
    period: '2014 — 2016',
    roles: [
      'Management Trainee · Minor International — Anantara Maldives → AVANI KL → Bangkok office',
      'Finance Manager · AVANI Hotels & Resorts, Kuala Lumpur',
    ],
    note: 'A management trainee is a suitcase with a job title. Ended up running monthly P&Ls and credit control in KL.',
  },
  {
    flags: ['🇭🇰'],
    stamps: ['🇻🇳 Vietnam', '🇮🇩 Indonesia', '🇹🇭 Thailand', '🇦🇪 Dubai', '🇰🇷 Korea', '🇦🇺 Australia', '🇨🇳 China'],
    city: 'Hong Kong — The Wandering Auditor',
    period: '2016 — 2018',
    roles: ['MOR Leader (Internal Audit), Finance · Hyatt'],
    note: 'Two years auditing hotel finance operations across seven countries. Hotels opened their books; I brought the skepticism.',
  },
  {
    flags: ['🇨🇳'],
    city: 'Shanghai',
    period: '2018 — 2023',
    roles: [
      'Feasibility Manager, Real Estate & Development · Hyatt',
      'Senior Feasibility Manager · Hyatt',
    ],
    note: 'Learned the craft here, with colleagues who made it fun — and my wife opened a kopi shop, so Shanghai stays on the route.',
  },
  {
    flags: ['🇭🇰'],
    city: 'Hong Kong, again',
    period: '2023 — now',
    roles: [
      'Senior Feasibility Manager · Hyatt',
      'Director of Feasibility · Hyatt',
    ],
    note: 'Now I direct the skepticism.',
  },
];

const wherenow = [
  { label: 'Base camp', value: 'Shenzhen' },
  { label: 'Work', value: 'Hong Kong' },
  { label: 'Home', value: 'Singapore' },
  { label: 'Heart', value: 'Shanghai' },
];

// TODO(you): replace with how you actually want to be contacted.
const contact = {
  email: 'hello@example.com', // consider an obfuscated form later
  linkedin: 'https://www.linkedin.com/in/sir-liang-ng-283a7482/',
};
---

<BaseLayout title="About" description="Hotel feasibility executive at Hyatt; AI hobbyist in Hong Kong.">
  <section class="hero">
    <h1>About</h1>
    <p class="lede">
      Singaporean, currently on loan to Hong Kong. I started out selling hotel
      rooms in Laos; these days I decide which hotel rooms get to exist —
      feasibility for Hyatt deals, which on paper is market studies and
      investment models, and in practice is telling excited people their dream
      hotel should stay a dream. In between: hotel school in Switzerland,
      finance in Malaysia and the Maldives, and two years as a wandering
      auditor stamping through seven countries. I still can't walk past a
      building site without estimating the room rate. Off duty I build small
      AI tools and automations — this site is where they live.
    </p>
    <p class="lede">English · 中文 · ไทย · ລາວ</p>
  </section>

  <section>
    <h2>The route so far</h2>
    <p class="city-note" style="margin-top: -0.5rem;">
      The wandering auditor's log — scroll down, the stamps fill in.
    </p>
    <div class="cities">
      {cities.map((c) => (
        <div class="city">
          <div class="city-head">
            <h3><span class="flags">{c.flags.join(' ')}</span> {c.city}</h3>
            <span class="period">{c.period}</span>
          </div>
          {c.roles.length > 0 && (
            <ul class="roles">
              {c.roles.map((r) => <li>{r}</li>)}
            </ul>
          )}
          {c.stamps && (
            <p class="stamps">
              {c.stamps.map((s) => <span class="stamp">{s}</span>)}
            </p>
          )}
          <p class="city-note">{c.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>Where things are now</h2>
    <ul class="wherenow">
      {wherenow.map((n) => (
        <li><span class="chip-label">{n.label}</span><strong>{n.value}</strong></li>
      ))}
    </ul>
    <p class="city-note">
      The four-city life isn't a lifestyle choice — it's a boarding pass collection.
    </p>
  </section>

  <section>
    <h2>Contact</h2>
    <p>
      Email: <a href={`mailto:${contact.email}`}>{contact.email}</a><br />
      LinkedIn: <a href={contact.linkedin} rel="me">sir-liang-ng</a>
    </p>
  </section>
</BaseLayout>

<style>
  /* City chapters — a travel-log version of the old timeline */
  .cities { display: flex; flex-direction: column; gap: 1.9rem; margin: 1.5rem 0; }
  .city {
    border-left: 2px solid var(--border);
    padding-left: 1.25rem;
    position: relative;
  }
  .city::before {
    content: "";
    position: absolute;
    left: -5px;
    top: 0.5rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .city-head { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; }
  .city-head h3 { margin: 0; font-size: 1.05rem; }
  .period { font-size: 0.85rem; color: var(--muted); }
  .roles { list-style: none; margin: 0.6rem 0 0.4rem; padding: 0; }
  .roles li { font-size: 0.925rem; color: var(--text); margin-bottom: 0.2rem; }
  .city-note { margin: 0.25rem 0 0; color: var(--muted); font-style: italic; font-size: 0.925rem; }

  /* The wanderer strip */
  .wherenow { list-style: none; display: flex; flex-wrap: wrap; gap: 0.75rem; padding: 0; margin: 1rem 0 0.75rem; }
  .wherenow li {
    border: 1px solid var(--border);
    background: var(--card);
    border-radius: 0.6rem;
    padding: 0.5rem 0.9rem;
    font-size: 0.9rem;
  }
  .chip-label { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-right: 0.45rem; }

  /* Flags & audit stamps */
  .flags { font-size: 1.15rem; letter-spacing: 0.12em; }
  .stamps { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0.55rem 0 0.25rem; padding: 0; }
  .stamp {
    border: 1px dashed var(--border);
    border-radius: 999px;
    padding: 0.18rem 0.65rem;
    font-size: 0.8rem;
    color: var(--muted);
    background: var(--card);
  }

  /* Scroll reveal — hidden only when JS is available (the .js class),
     so no-JS visitors and search engines see everything. */
  .js .city {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  .js .city.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .js .city { transition: none; transform: none; }
  }
</style>

<script is:inline>
  // Progressive enhancement: reveal each city chapter as it scrolls into view.
  // IntersectionObserver = "tell me when this element enters the viewport".
  document.documentElement.classList.add('js');
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }),
    { threshold: 0.2 }
  );
  document.querySelectorAll('.city').forEach((c) => io.observe(c));
</script>
