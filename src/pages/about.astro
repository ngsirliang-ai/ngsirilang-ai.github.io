---

<BaseLayout title="About" description="Hotel feasibility executive at Hyatt; AI hobbyist in Hong Kong.">
  <section class="hero">
    <h1>About</h1>
    <p class="lede">
      Singaporean, currently on loan to Hong Kong. I started out selling hotel
      rooms in Laos; these days I decide which hotel rooms get to exist —
      feasibility for Hyatt deals, which on paper is market studies and
      investment models, and in practice is telling excited people their dream
      hotel should stay a dream. In between: hotel school in Switzerland,
      finance in Malaysia and the Maldives, and two years as a wandering
      auditor stamping through seven countries. I still can't walk past a
      building site without estimating the room rate. Off duty I build small
      AI tools and automations — this site is where they live.
    </p>
    <p class="lede">English · 中文 · ไทย · ລາວ</p>
  </section>

  <section>
    <h2>The route so far</h2>
    <p class="city-note" style="margin-top: -0.5rem;">
      The wandering auditor's log — hover or tap a stop to open it.
    </p>
    <div class="cities">
      {cities.map((c, i) => (
        <div class:list={['stop', i === 0 && 'open']}>
          <button type="button" class="stop-head" aria-expanded={i === 0 ? 'true' : 'false'}>
            <span class="flags">{c.flags.join(' ')}</span>
            <span class="stop-name">{c.city}</span>
            <span class="period">{c.period}</span>
            <span class="chev" aria-hidden="true">▾</span>
          </button>
          <div class="stop-body">
            <div class="stop-inner">
              {c.roles.length > 0 && (
                <ul class="roles">
                  {c.roles.map((r) => <li>{r}</li>)}
                </ul>
              )}
              {c.stamps && (
                <p class="stamps">
                  {c.stamps.map((s) => <span class="stamp">{s}</span>)}
                </p>
              )}
              <p class="city-note">{c.note}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>Where things are now</h2>
    <ul class="wherenow">
      {wherenow.map((n) => (
        <li><span class="chip-label">{n.label}</span><strong>{n.value}</strong></li>
      ))}
    </ul>
    <p class="city-note">
      The four-city life isn't a lifestyle choice — it's a boarding pass collection.
    </p>
  </section>

  <section>
    <h2>Contact</h2>
    <p>
      Email: <a href={`mailto:${contact.email}`}>{contact.email}</a><br />
      LinkedIn: <a href={contact.linkedin} rel="me">sir-liang-ng</a>
    </p>
  </section>
</BaseLayout>

<style>
  /* City stops — collapsed headers that expand on hover (desktop) or tap.
     The .stop-body uses the grid 0fr→1fr trick: CSS can't animate
     height:auto, but it CAN animate a grid row from 0 to 1 fraction. */
  .cities { display: flex; flex-direction: column; gap: 0.6rem; margin: 1.5rem 0; }
  .stop {
    border-left: 2px solid var(--border);
    padding: 0 0 0 1.1rem;
    position: relative;
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .stop::before {
    content: "";
    position: absolute;
    left: -5px;
    top: 1.05rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border);
    transition: background 0.3s ease;
  }
  .stop.open::before { background: var(--accent); }
  .stop-head {
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    width: 100%;
    padding: 0.65rem 0.25rem;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }
  .stop-head:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 0.35rem; }
  .stop-name { font-weight: 600; font-size: 1.02rem; }
  .stop-head .period { margin-left: auto; white-space: nowrap; }
  .chev {
    font-size: 0.8rem;
    color: var(--muted);
    transition: transform 0.35s ease;
  }
  .stop.open .chev { transform: rotate(180deg); }
  .stop-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s ease;
  }
  .stop.open .stop-body { grid-template-rows: 1fr; }
  .stop-inner { overflow: hidden; min-height: 0; }
  .stop-inner .roles { margin-top: 0.15rem; }
  @media (prefers-reduced-motion: reduce) {
    .stop-body, .chev, .stop::before { transition: none; }
  }
  .roles { list-style: none; margin: 0.6rem 0 0.4rem; padding: 0; }
  .roles li { font-size: 0.925rem; color: var(--text); margin-bottom: 0.2rem; }
  .city-note { margin: 0.25rem 0 0; color: var(--muted); font-style: italic; font-size: 0.925rem; }

  /* The wanderer strip */
  .wherenow { list-style: none; display: flex; flex-wrap: wrap; gap: 0.75rem; padding: 0; margin: 1rem 0 0.75rem; }
  .wherenow li {
    border: 1px solid var(--border);
    background: var(--card);
    border-radius: 0.6rem;
    padding: 0.5rem 0.9rem;
    font-size: 0.9rem;
  }
  .chip-label { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-right: 0.45rem; }

  /* Flags & audit stamps */
  .flags { font-size: 1.15rem; letter-spacing: 0.12em; }
  .stamps { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0.55rem 0 0.25rem; padding: 0; }
  .stamp {
    border: 1px dashed var(--border);
    border-radius: 999px;
    padding: 0.18rem 0.65rem;
    font-size: 0.8rem;
    color: var(--muted);
    background: var(--card);
  }

  /* Scroll-reveal removed — stops now expand on hover/tap. */
</style>

<script is:inline>
  // Departure-board behavior:
  //  - On devices with a real mouse (hover: hover): passing over a stop
  //    opens it; moving away closes it again — unless you CLICK, which
  //    pins it open. Click again to unpin.
  //  - On touch: tap toggles. (No hover on phones, so clicks do all the work.)
  const canHover = window.matchMedia('(hover: hover)').matches;
  document.querySelectorAll('.stop-head').forEach((head) => {
    const stop = head.closest('.stop');
    const setOpen = (v) => {
      stop.classList.toggle('open', v);
      head.setAttribute('aria-expanded', String(v));
    };
    head.addEventListener('click', () => {
      const opening = !stop.classList.contains('open');
      setOpen(opening);
      stop.classList.toggle('pinned', opening && canHover);
    });
    if (canHover) {
      head.addEventListener('mouseenter', () => setOpen(true));
      head.addEventListener('mouseleave', () =>
        setOpen(stop.classList.contains('pinned')));
    }
  });
</script>
