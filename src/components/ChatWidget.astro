---
// ChatWidget — floating navigation assistant on every page.
// Phase A (now): scripted brain, pure client-side, no backend.
// Phase B (later): set RELAY_URL to the Cloudflare Worker and
// "connect" messages get relayed to Telegram. Until then the
// connect flow falls back to email + LinkedIn.
//
// Learning notes:
//  - This is a component with its own scoped styles + a vanilla script.
//  - The "brain" is an array of intents: keywords -> reply (+ optional
//    navigation). A real LLM upgrade later only replaces `think()`.
---

<!-- The launcher — a quiet footer link, not a floating bubble -->
<button type="button" id="chat-launcher" aria-expanded="false">💬 Ask me</button>

<!-- The chat panel -->
<div id="chat-panel" role="dialog" aria-label="Chat assistant" hidden>
  <div class="chat-head">
    <strong>Site guide</strong>
    <button type="button" id="chat-close" aria-label="Close chat">✕</button>
  </div>

  <div id="chat-log" aria-live="polite"></div>

  <div id="chat-chips" class="chat-chips"></div>

  <form id="chat-form">
    <input type="text" id="chat-input" autocomplete="off"
           placeholder="Ask about projects, William, hazes…" aria-label="Your message" />
    <button type="submit" aria-label="Send">➤</button>
  </form>

  <!-- honeypot for future spam bots (real blocking comes with the Worker) -->
  <input type="text" id="chat-hp" tabindex="-1" autocomplete="off" hidden />
</div>

<style>
  /* Launcher — styled like a footer text link, zero footprint until clicked */
  #chat-launcher {
    all: unset;
    cursor: pointer;
    font: inherit;
    font-size: 0.875rem;
    color: var(--accent);
  }
  #chat-launcher:hover { text-decoration: underline; }

  #chat-panel[hidden] { display: none; } /* hidden must win over display:flex — fixes X-to-close */

  /* Panel */
  #chat-panel {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 60;
    width: min(21rem, calc(100vw - 2.2rem));
    max-height: min(30rem, 70vh);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    background: var(--card);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.22);
    overflow: hidden;
  }
  .chat-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  .chat-head button {
    all: unset;
    cursor: pointer;
    color: var(--muted);
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
  }
  .chat-head button:hover { color: var(--text); }

  #chat-log {
    flex: 1;
    overflow-y: auto;
    padding: 0.8rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .msg { max-width: 88%; padding: 0.5rem 0.7rem; border-radius: 0.7rem; font-size: 0.88rem; line-height: 1.45; }
  .msg.bot { background: var(--bg); border: 1px solid var(--border); border-bottom-left-radius: 0.2rem; align-self: flex-start; }
  .msg.user { background: var(--accent); color: #fff; border-bottom-right-radius: 0.2rem; align-self: flex-end; }
  .msg a { color: var(--accent); }

  /* The connect mini-form rendered inside the log */
  .msg form { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 0.4rem; }
  .msg input, .msg textarea {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 0.45rem;
    background: var(--card);
    color: var(--text);
  }
  .msg button {
    font: inherit;
    font-size: 0.85rem;
    border: none;
    border-radius: 0.45rem;
    background: var(--accent);
    color: #fff;
    padding: 0.45rem 0.7rem;
    cursor: pointer;
  }

  .chat-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0 0.9rem 0.6rem;
  }
  .chat-chips button {
    font: inherit;
    font-size: 0.76rem;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--muted);
    border-radius: 999px;
    padding: 0.25rem 0.65rem;
    cursor: pointer;
  }
  .chat-chips button:hover { border-color: var(--accent); color: var(--text); }

  #chat-form { display: flex; gap: 0.45rem; padding: 0.7rem 0.9rem; border-top: 1px solid var(--border); }
  #chat-form input {
    flex: 1;
    font: inherit;
    font-size: 0.88rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--bg);
    color: var(--text);
  }
  #chat-form button {
    all: unset;
    cursor: pointer;
    color: var(--accent);
    padding: 0 0.4rem;
    font-size: 1.05rem;
  }
</style>

<script is:inline>
  // ── Configuration ────────────────────────────────────────────────
  // Phase B: live since 2026-10-22 — worker deployed at:
  const RELAY_URL = 'https://site-relay.ngsirliang.workers.dev/message';

  // ── The scripted brain ───────────────────────────────────────────
  const INTENTS = [
    {
      keys: ['project', 'work', 'build', 'portfolio', 'homesignal', 'pulse', 'dashboard', 'app'],
      reply: 'William builds small AI tools — the standouts are <strong>HomeSignal</strong> (Singapore HDB resale monitor) and <strong>Singapore Pulse</strong> (live island signals). Both have live demos. Taking you there…',
      go: '/projects/',
    },
    {
      keys: ['automation', 'haze', 'psi', 'telegram', 'bot', 'monitor'],
      reply: 'The <strong>SG Haze Monitor</strong> is his favourite automation — his parents in Singapore get PSI readings on Telegram twice a day, plus alerts. You can see the actual message format. Taking you there…',
      go: '/automations/',
    },
    {
      keys: ['who', 'about', 'background', 'career', 'william', 'liang', 'hyatt', 'auditor', 'feasibility', 'hotel'],
      reply: 'Short version: hotel feasibility director at Hyatt in Hong Kong, ex wandering auditor (7 countries), started in hotel sales in Laos. The full route is a fun scroll. Taking you there…',
      go: '/about/',
    },
    {
      keys: ['writing', 'blog', 'post', 'article', 'read'],
      reply: 'The writing section is being stocked — feasibility practice, APAC hotel markets, and building automations as a non-developer. Taking you there…',
      go: '/writing/',
    },
    {
      keys: ['contact', 'connect', 'email', 'reach', 'talk', 'message', 'hire', 'job', 'linkedin'],
      reply: '__CONNECT__',
    },
  ];

  const FALLBACK = 'I\'m a simple guide — try asking about <em>projects</em>, the <em>haze monitor</em>, <em>who William is</em>, or say <em>connect</em> to reach him.';

  // ── Widget plumbing (open/close, render, submit) ────────────────
  const launcher = document.getElementById('chat-launcher');
  const panel = document.getElementById('chat-panel');
  const log = document.getElementById('chat-log');
  const chips = document.getElementById('chat-chips');
  const form = document.getElementById('chat-form');
  const input = document.getElementById('chat-input');

  function say(text, who) {
    const div = document.createElement('div');
    div.className = 'msg ' + who;
    div.innerHTML = text;
    log.appendChild(div);
    log.scrollTop = log.scrollHeight;
    return div;
  }

  function think(text) {
    const t = text.toLowerCase();
    for (const intent of INTENTS) {
      if (intent.keys.some((k) => t.includes(k))) return intent;
    }
    return null;
  }

  // ── Two-way chat state ───────────────────────────────────────────
  let SID = localStorage.getItem('chat-sid') || '';
  let VISITOR_NAME = localStorage.getItem('chat-name') || '';
  let CONV = false;   // true once the visitor chose to talk to William
  let rendered = 0;   // thread entries already on screen
  let pollTimer = null;

  function safeSay(prefix, text, who) {
    const div = document.createElement('div');
    div.className = 'msg ' + who;
    if (prefix) {
      const b = document.createElement('strong');
      b.textContent = prefix;
      div.appendChild(b);
    }
    div.appendChild(document.createTextNode(text));
    log.appendChild(div);
    log.scrollTop = log.scrollHeight;
  }

  function replyBase() { return RELAY_URL.replace(/\/message$/, '/reply'); }

  async function sendToWilliam(text) {
    const typing = safeSay('', '…', 'bot');
    try {
      const r = await fetch(RELAY_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: VISITOR_NAME, text, page: location.pathname, sid: SID }),
        signal: AbortSignal.timeout(10000), // don't spin forever on blocked networks
      });
      const data = await r.json();
      typing.remove();
      if (!r.ok || !data.ok) throw new Error('relay');
      if (data.sid) { SID = data.sid; localStorage.setItem('chat-sid', SID); }
      localStorage.setItem('chat-name', VISITOR_NAME);
      rendered++; // our own message is already on screen
      safeSay('', 'Sent to William\'s Telegram ✓ — his reply will appear right here. He usually answers within a day; this chat remembers you for 24 hours.', 'bot');
      startPolling();
    } catch (err) {
      typing.remove();
      safeSay('', 'This network can\'t reach William\'s relay right now (common inside mainland China). Email works everywhere: cue-vmitjb@bot.cue.im', 'bot');
    }
  }

  function startPolling() {
    if (pollTimer || !RELAY_URL || !SID) return;
    pollTimer = setInterval(async () => {
      if (panel.hidden) return;
      try {
        const r = await fetch(replyBase() + '?sid=' + SID);
        const data = await r.json();
        if (data.ok) renderThread(data.messages || []);
      } catch (e) { /* offline — retry next tick */ }
    }, 4000);
  }

  async function fetchThread() {
    try {
      const r = await fetch(replyBase() + '?sid=' + SID);
      const data = await r.json();
      if (data.ok) renderThread(data.messages || []);
    } catch (e) {}
  }

  function renderThread(thread) {
    for (let i = rendered; i < thread.length; i++) {
      const m = thread[i];
      if (m.who === 'william') safeSay('William: ', m.text, 'bot');
      else safeSay(m.name ? m.name + ': ' : '', m.text, 'user');
      rendered = i + 1;
    }
  }

  function startConversation() {
    if (!RELAY_URL) {
      location.href = 'mailto:cue-vmitjb@bot.cue.im?subject=Hello%20William';
      return;
    }
    CONV = true;
    if (VISITOR_NAME) {
      safeSay('', 'You\'re connected to William\'s Telegram, ' + VISITOR_NAME + '. Type your message and he gets it instantly — his replies appear right here.', 'bot');
    } else {
      safeSay('', 'You\'re connected to William\'s Telegram. First — what\'s your name?', 'bot');
    }
    if (SID) { rendered = 0; fetchThread(); startPolling(); }
    input.focus();
  }

  function respond(text) {
    const intent = think(text);
    if (intent && intent.reply === '__CONNECT__') { startConversation(); return; }
    if (CONV) {
      if (!VISITOR_NAME) {
        VISITOR_NAME = text.slice(0, 80);
        safeSay('', 'Nice to meet you, ' + VISITOR_NAME + '. What did you want to tell William?', 'bot');
        return;
      }
      sendToWilliam(text);
      return;
    }
    if (intent) {
      say(intent.reply, 'bot');
      if (intent.go) setTimeout(() => { location.href = intent.go; }, 1400);
      return;
    }
    safeSay('', 'No scripted answer for that — but I can pass it straight to William on Telegram. Say <em>connect</em>, or just tell me your name and your message.', 'bot');
  }

  // quick chips
  const CHIPS = ['Projects', 'Who is William?', 'Haze monitor', 'Connect'];
  CHIPS.forEach((c) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = c;
    b.addEventListener('click', () => { say(c, 'user'); respond(c); });
    chips.appendChild(b);
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text) return;
    say(text, 'user');
    input.value = '';
    respond(text);
  });

  launcher.addEventListener('click', () => {
    const open = panel.hidden;
    panel.hidden = !open;
    launcher.setAttribute('aria-expanded', String(open));
    if (open && log.children.length === 0) {
      say('Hi! I\'m the site guide. Ask me about William\'s projects, his automation habit — or say <em>connect</em> to chat with him directly.', 'bot');
    }
    if (open && CONV && SID) { rendered = 0; fetchThread(); startPolling(); }
    if (open) input.focus();
  });
  document.getElementById('chat-close').addEventListener('click', () => {
    panel.hidden = true;
    launcher.setAttribute('aria-expanded', 'false');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) { panel.hidden = true; launcher.focus(); }
  });
  // Close when clicking anywhere outside the panel or the launcher link
  document.addEventListener('click', (e) => {
    if (panel.hidden) return;
    const t = e.target;
    if (!panel.contains(t) && t !== launcher && !launcher.contains(t)) {
      panel.hidden = true;
      launcher.setAttribute('aria-expanded', 'false');
    }
  });
</script>
